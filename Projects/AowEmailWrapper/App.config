<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <appSettings>
    <add key="NotifySound" value="notify.wav" />
    <add key="SentSound" value="sent.wav" />
    <add key="AutostartPauseSeconds" value="5" />
    <add key="Mozilla.Autoconfig.IspDbTemplate" value="https://autoconfig.thunderbird.net/v1.1/{0}"/>
    <!-- Application (client) ID of the Azure app registration used for Sign in with Microsoft. Empty disables it. See README. -->
    <add key="Microsoft.OAuth.ClientId" value="5f3bbb87-e216-4f5f-94ee-0d7ebb90fda8"/>
    <!-- Sign-in endpoint: .../consumers for a registration limited to personal accounts (default), .../common if it allows work accounts too -->
    <add key="Microsoft.OAuth.Authority" value="https://login.microsoftonline.com/consumers"/>
    <!-- GitHub repository (owner/name) whose releases the update check looks at. Empty disables update checks. See README. -->
    <add key="Update.Repository" value="legalmumbojumbo/AowEmailWrapper"/>
    <!-- Address the About tab's "Report a bug" button sends reports (with the Wrapper's log attached) to -->
    <add key="BugReport.Email" value="eugene.j.wolff@gmail.com"/>
  </appSettings>
</configuration>